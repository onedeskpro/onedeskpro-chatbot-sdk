{
  "name": "@onedeskpro/chatbot-react",
  "version": "0.1.0",
  "description": "React SDK for the Onedesk Pro Chatbot",
  "license": "MIT",
  "author": "Typetech IT <support@onedeskpro.com>",
  "homepage": "https://github.com/typetechit/onedeskpro-chatbot-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typetechit/onedeskpro-chatbot-sdk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/typetechit/onedeskpro-chatbot-sdk/issues"
  },
  "keywords": [
    "onedeskpro",
    "chatbot",
    "react",
    "chat-widget",
    "customer-support",
    "sdk"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && cp dist/index.d.ts dist/index.d.cts",
    "test": "vitest run",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@onedeskpro/chatbot-core": "workspace:*",
    "@onedeskpro/chatbot-types": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^25",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2"
  }
}
